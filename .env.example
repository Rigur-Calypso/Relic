# Comma-separated pool of free-tier keys (from different Google accounts).
# RELIC rotates to the next key automatically when one hits its 20/day quota.
GEMINI_API_KEYS=key1,key2,key3
GEMINI_API_KEY=your_key_here    # single-key fallback if GEMINI_API_KEYS is unset
GEMINI_MODEL=gemini-3.6-flash   # gemini-2.0-flash was retired by Google; 3.6-flash is the current drop-in

# Grok (xAI) fallback — used automatically when Gemini keys are exhausted.
XAI_API_KEY=your_xai_key_here
GROK_MODEL=grok-3
LLM_PROVIDER=auto               # auto = Gemini→Grok | grok = Grok only | gemini = Gemini only
BRIGHTDATA_API_KEY=your_key_here   # optional; skips interactive bdata login
BDATA_BIN=bdata                    # or an absolute path to the binary
